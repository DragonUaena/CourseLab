COURSELAB_SECRET_KEY=replace-with-a-long-random-string
COURSELAB_CREDENTIAL_KEY=
COURSELAB_DATABASE_URL=sqlite:///./data/courselab.db
COURSELAB_ACCESS_TOKEN_MINUTES=10080
COURSELAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared defaults. Users can also enter their own keys in Settings.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
COURSELAB_LLM_MODEL=openai/gpt-4o-mini
COURSELAB_TAVILY_RESULTS_PER_QUERY=4
COURSELAB_TAVILY_MAX_SOURCES=12
COURSELAB_PROMPT_SOURCE_CHARS=420
COURSELAB_LLM_MAX_TOKENS=12000
COURSELAB_LLM_REASONING_EFFORT=low

